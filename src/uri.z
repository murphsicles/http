// http/src/uri.z — HTTP URI type

// Represents a URI used in HTTP requests.
// For MVP, stores the string and provides accessor methods.
struct Uri {
    raw: str,
    // Cached parsed components
    scheme_end: i64,
    authority_end: i64,
    path_end: i64,
    query_start: i64,
    fragment_start: i64,
}

impl Uri {
    // Common URI scheme constants
    const HTTP: Uri = Uri::from_static("http");
    const HTTPS: Uri = Uri::from_static("https");

    fn from_static(src: &str) -> Uri {
        let mut u = Uri {
            raw: src,
            scheme_end: -1,
            authority_end: -1,
            path_end: -1,
            query_start: -1,
            fragment_start: -1,
        };
        u.parse_components();
        return u;
    }

    // Parse a URI string into components
    fn from_str(src: &str) -> Result<Uri, InvalidUri> {
        if src.len() == 0 {
            return Result::Err(InvalidUri::new());
        }
        let mut u = Uri {
            raw: src,
            scheme_end: -1,
            authority_end: -1,
            path_end: -1,
            query_start: -1,
            fragment_start: -1,
        };
        u.parse_components();
        return Result::Ok(u);
    }

    fn parse_components(&mut self) {
        let s = self.raw;
        let len = s.len();
        let mut i = 0;

        // Parse scheme: [a-zA-Z][a-zA-Z0-9+.-]*
        if i < len && ((s[i] >= 'a' as u8 && s[i] <= 'z' as u8)
                     || (s[i] >= 'A' as u8 && s[i] <= 'Z' as u8)) {
            let mut j = i + 1;
            while j < len {
                let c = s[j];
                if (c >= 'a' as u8 && c <= 'z' as u8)
                    || (c >= 'A' as u8 && c <= 'Z' as u8)
                    || (c >= '0' as u8 && c <= '9' as u8)
                    || c == '+' as u8 || c == '-' as u8 || c == '.' as u8 {
                    j += 1;
                } else if c == ':' as u8 {
                    self.scheme_end = j;
                    i = j + 1;
                    break;
                } else {
                    // No scheme; handle as relative
                    self.scheme_end = -1;
                    i = 0;
                    break;
                }
            }
        }

        // Parse authority: "//" host [":" port]
        if i + 1 < len && s[i] == '/' as u8 && s[i + 1] == '/' as u8 {
            i += 2;
            while i < len {
                let c = s[i];
                if c == '/' as u8 || c == '?' as u8 || c == '#' as u8 {
                    break;
                }
                i += 1;
            }
            self.authority_end = i;
        }

        // Path is everything from current position to '?' or '#'
        self.path_end = i;
        while i < len {
            let c = s[i];
            if c == '?' as u8 {
                self.query_start = i;
                i += 1;
                break;
            }
            if c == '#' as u8 {
                self.fragment_start = i;
                return;
            }
            i += 1;
        }

        // Parse query
        while i < len {
            if s[i] == '#' as u8 {
                self.fragment_start = i;
                return;
            }
            i += 1;
        }
    }

    // ─── Accessors ────────────────────────────────────────────────────────

    fn as_str(&self) -> &str {
        return self.raw;
    }

    fn scheme(&self) -> &str {
        if self.scheme_end < 0 {
            return "";
        }
        return self.raw[0..self.scheme_end];
    }

    fn authority(&self) -> &str {
        if self.authority_end < 0 {
            return "";
        }
        // Find start of authority (after "//")
        let mut start = 0;
        let len = self.raw.len();
        let mut i = 0;
        if self.scheme_end >= 0 {
            i = self.scheme_end + 1; // skip ':'
        }
        if i + 1 < len && self.raw[i] == '/' as u8 && self.raw[i + 1] == '/' as u8 {
            start = i + 2;
        }
        return self.raw[start..self.authority_end];
    }

    fn host(&self) -> &str {
        let auth = self.authority();
        if auth.len() == 0 { return ""; }
        // Find ':port' separator
        let mut i = 0;
        let a_len = auth.len();
        // Handle IPv6: [::1]:port
        if a_len > 0 && auth[0] == '[' as u8 {
            while i < a_len {
                if auth[i] == ']' as u8 {
                    return auth[0..i + 1];
                }
                i += 1;
            }
        }
        // Look for port separator
        i = 0;
        while i < a_len {
            if auth[i] == ':' as u8 {
                return auth[0..i];
            }
            i += 1;
        }
        return auth;
    }

    fn port(&self) -> u16 {
        let auth = self.authority();
        let a_len = auth.len();
        // Find ':port'
        let mut i = 0;
        if a_len > 0 && auth[0] == '[' as u8 {
            // Skip IPv6 address
            while i < a_len {
                if auth[i] == ']' as u8 {
                    i += 1;
                    if i < a_len && auth[i] == ':' as u8 {
                        return Uri::parse_port(auth[i + 1..a_len]);
                    }
                    return 0;
                }
                i += 1;
            }
            return 0;
        }
        while i < a_len {
            if auth[i] == ':' as u8 {
                return Uri::parse_port(auth[i + 1..a_len]);
            }
            i += 1;
        }
        return 0; // No explicit port
    }

    fn parse_port(s: &str) -> u16 {
        let mut val: u16 = 0;
        let mut i = 0;
        let len = s.len();
        while i < len {
            let c = s[i];
            if c >= '0' as u8 && c <= '9' as u8 {
                val = val * 10 + (c - '0' as u8) as u16;
            } else {
                return 0;
            }
            i += 1;
        }
        return val;
    }

    fn path(&self) -> &str {
        let len = self.raw.len();
        let start = if self.authority_end >= 0 { self.authority_end } else { 0 };
        let end = if self.query_start >= 0 { self.query_start }
                  else if self.fragment_start >= 0 { self.fragment_start }
                  else { len };
        if start >= end { return "/"; }
        let p = self.raw[start..end];
        if p.len() == 0 { return "/"; }
        return p;
    }

    fn query(&self) -> &str {
        if self.query_start < 0 { return ""; }
        let start = self.query_start + 1;
        let end = if self.fragment_start >= 0 { self.fragment_start }
                  else { self.raw.len() };
        if start >= end { return ""; }
        return self.raw[start..end];
    }

    fn fragment(&self) -> &str {
        if self.fragment_start < 0 { return ""; }
        return self.raw[self.fragment_start + 1..self.raw.len()];
    }
}

struct InvalidUri {
    _priv: i64,
}

impl InvalidUri {
    fn new() -> InvalidUri {
        return InvalidUri { _priv: 0 };
    }
}
